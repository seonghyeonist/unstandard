# ========================================
# Unstandard .gitignore
# Next.js + Node.js monorepo
# ========================================

# --- Dependencies ---
node_modules/
.pnp
.pnp.js

# --- Python (depth-service) ---
.venv/
__pycache__/
*.py[cod]
.pytest_cache/

# --- Build / Output ---
.next/
out/
build/
dist/

# --- Environment Variables (절대 커밋 금지) ---
.env
.env.*
.env.local
.env.development
.env.development.local
.env.test
.env.test.local
.env.production
.env.production.local
.env*.local

# --- Testing ---
coverage/
.nyc_output/

# --- Debug ---
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- IDE ---
.vscode/
.idea/
*.swp
*.swo
*~

# --- OS ---
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# --- TypeScript ---
*.tsbuildinfo
next-env.d.ts

# --- Vercel ---
.vercel

# --- Docker ---
docker-compose.override.yml

# --- Confidential offline label data (절대 커밋 금지) ---
# Narrow on purpose. See docs/LOCAL_AI_LABEL_DATASET_GATE.md — a broad *.xlsx
# rule would also hide legitimate spreadsheets and make a renamed copy of the
# workbook harder to spot in review.
project_sources/01-Unstandard_LabelingDataset_v0.1.xlsx
Unstandard_LabelingDataset_v0.1.xlsx
01-Unstandard_LabelingDataset_v0.1.xlsx
private-data/local-ai/
private-data/local-ai/**
artifacts/local-ai-labeling/raw/
artifacts/local-ai/
artifacts/local-ai/**

# --- Local AI technical PoC (repo-side spill; primary store is /tmp/unstandard-local-ai/) ---
.cache/huggingface/
.cache/huggingface/**
.cache/torch/
.cache/torch/**
.huggingface/
huggingface/hub/

# --- Founder attachment dumps at repo root (never commit) ---
/Unstandard_*.pdf
/Unstandard_*.docx
/Unstandard_*.xlsx

# --- Misc ---
*.log
*.pid
*.seed
*.pid.lock
