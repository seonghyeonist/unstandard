{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "installCommand": "npm ci",
  "outputDirectory": "dist",
  "functions": {
    "api/b2c/**/*.ts": { "includeFiles": "{server,db}/*.mts" }
  },
  "routes": [
    {"src": "/(checkout|recover)", "dest": "/api/b2c/$1", "continue": false},
    {"handle": "filesystem"}
  ]
}
