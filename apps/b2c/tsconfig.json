{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "noEmit": true,
    "types": [
      "node"
    ],
    "allowImportingTsExtensions": true,
    "skipLibCheck": true
  },
  "include": [
    "src/*.mjs",
    "scripts/*.mjs",
    "server/*.mts",
    "db/*.mts",
    "scripts/*.mts",
    "tests/*.mts",
    "drizzle.config.mts"
  ]
}
