{
  "name": "@unstandard/b2c",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "lint": "eslint --config eslint.config.mjs src scripts server db tests drizzle.config.mts --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test tests/*.test.mjs tests/*.test.mts",
    "build": "node scripts/build.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "start": "node server/start.mts",
    "db:generate": "drizzle-kit generate --config drizzle.config.mts",
    "db:migrate": "node scripts/migrate.mts",
    "test:db": "node --test tests/*.integration.mts"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/pg": "8.23.1",
    "@typescript-eslint/parser": "8.73.0",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "tsx": "4.22.4",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "drizzle-orm": "0.45.3",
    "pg": "8.23.1"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    }
  }
}
