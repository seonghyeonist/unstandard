{
  "name": "@unstandard/b2c",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "lint": "eslint --config eslint.config.mjs src scripts server db tests api drizzle.config.mts --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test tests/*.test.mjs tests/*.test.mts",
    "build": "node scripts/build.mjs",
    "check": "npm run lint && npm run typecheck && npm test && npm run build",
    "start": "node server/start.mts",
    "db:generate": "drizzle-kit generate --config drizzle.config.mts",
    "db:migrate": "node scripts/migrate.mts",
    "test:db": "node --test tests/*.integration.mts",
    "b2c:test:unit": "node scripts/test-summary.mts unit",
    "b2c:test:db": "node scripts/test-summary.mts db",
    "b2c:test:payment:synthetic": "node scripts/test-summary.mts synthetic",
    "b2c:paddle:preflight": "node scripts/paddle-sandbox.mts preflight",
    "b2c:paddle:provision": "node scripts/paddle-sandbox.mts provision",
    "b2c:paddle:simulator": "node scripts/paddle-sandbox.mts simulator",
    "b2c:test:checkout:sandbox": "node scripts/checkout-sandbox.mts",
    "b2c:test:payment:reconcile": "node scripts/payment-jobs.mts",
    "b2c:test:all": "node scripts/test-summary.mts all"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "24.13.3",
    "@types/pg": "8.23.1",
    "@typescript-eslint/parser": "8.73.0",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "tsx": "4.22.4",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@paddle/paddle-node-sdk": "3.12.0",
    "drizzle-orm": "0.45.3",
    "pg": "8.23.1"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    }
  }
}
